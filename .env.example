# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: comma-separated email domains allowed to host retros (empty = anyone)
ALLOWED_HOST_EMAIL_DOMAINS=

# Server-only secret for host PIN sign-in (long random string; store its sha256 in private.app_secrets)
PIN_SECRET=

# Integration tests only — never expose to the browser or Vercel
SUPABASE_SERVICE_ROLE_KEY=
